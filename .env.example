# ==============================================================================
# English Young 8 — Environment Variables Template
# ==============================================================================
# Sao chép file này thành `.env.local` khi chạy ở máy cục bộ (file `.env.local`
# đã được chặn trong .gitignore để không bị đẩy lên GitHub).
# Khi triển khai lên Vercel, cấu hình các biến này tại:
# Project Settings -> Environment Variables.

# Supabase Project URL (ví dụ: https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=

# Supabase Publishable / Anon Key (KHÔNG BAO GIỜ đặt service_role key ở frontend)
VITE_SUPABASE_ANON_KEY=

# Chỉ bật nút điền nhanh tài khoản Admin mẫu trong môi trường phát triển/demo
# Mặc định trên production là false
VITE_ENABLE_DEMO_ADMIN=false
